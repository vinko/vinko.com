---
import BlogArchive from "../../components/BlogArchive.astro";
import { getCollection } from "astro:content";
import { postYears, publishedPosts } from "../../lib/posts";

const PAGE_SIZE = 18;
const all = publishedPosts(await getCollection("posts"));
const years = postYears(all);
const lastPage = Math.max(1, Math.ceil(all.length / PAGE_SIZE));
const posts = all.slice(0, PAGE_SIZE);
---
<BlogArchive
  title="Blog"
  description="Blog archive — Vinko’s Thoughts On… at vinko.com"
  lead={`Posts migrated from the public vinko.com WordPress archive. ${all.length.toLocaleString("en-US")} entries, newest first.`}
  posts={posts}
  years={years}
  currentYear="all"
  page={1}
  lastPage={lastPage}
  pagerBase="/blog/"
/>
