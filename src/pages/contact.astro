---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Contact" description="Contact Vinko">
  <article class="page-shell page-shell--narrow">
    <header class="page-header">
      <h1>Contact Me</h1>
      <p class="lead">A few starting points — this static rebuild has no form backend.</p>
    </header>
    <div class="prose">
      <p class="note">
        <strong>Draft:</strong> The live WordPress contact form was not migrated into this static rebuild. Use the details below, or reach out via the channels linked from the original site.
      </p>
      <div class="contact-box">
        <p>
          For personal messages related to vinko.com, email or social profiles historically linked from the site (including Twitter/X
          <a href="https://twitter.com/vinko">@vinko</a>) are the best starting points.
        </p>
        <p>Hosting inquiries historically went through <a href="https://hosting.vinko.com">hosting.vinko.com</a>.</p>
        <p>This static site intentionally has no form backend and no secrets.</p>
      </div>
    </div>
  </article>
</BaseLayout>
