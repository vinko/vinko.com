---
interface Props {
  /** id of the tag-browser panel this button reveals */
  targetId: string;
}

const { targetId } = Astro.props;
---
<button
  type="button"
  class="tag-reveal-btn"
  aria-expanded="false"
  aria-controls={targetId}
  data-tag-filter-reveal
>
  Show filters
</button>

<script>
  const STORAGE_KEY = "vinko-sn-filters-open";

  function setupTagFilterReveal(button: HTMLButtonElement) {
    if (button.dataset.bound === "true") return;
    button.dataset.bound = "true";

    const targetId = button.getAttribute("aria-controls");
    const target = targetId ? document.getElementById(targetId) : null;
    if (!target) return;

    const sync = (expanded: boolean) => {
      button.setAttribute("aria-expanded", String(expanded));
      button.textContent = expanded ? "Hide filters" : "Show filters";
      target.hidden = !expanded;
    };

    let initial = false;
    try {
      initial = sessionStorage.getItem(STORAGE_KEY) === "1";
    } catch {
      initial = false;
    }
    sync(initial);

    button.addEventListener("click", () => {
      const next = button.getAttribute("aria-expanded") !== "true";
      sync(next);
      try {
        sessionStorage.setItem(STORAGE_KEY, next ? "1" : "0");
      } catch {
        /* private mode */
      }
    });
  }

  document.querySelectorAll<HTMLButtonElement>("[data-tag-filter-reveal]").forEach(setupTagFilterReveal);
</script>
