---
import { withBase } from "../lib/url";

interface Props {
  years: number[];
  current?: number | "all";
}

const { years, current = "all" } = Astro.props;
---
<nav class="year-nav" aria-label="Filter posts by year">
  <a href={withBase("/blog/")} aria-current={current === "all" ? "page" : undefined}>All</a>
  {years.map((year) => (
    <a href={withBase(`/blog/year/${year}/`)} aria-current={current === year ? "page" : undefined}>
      {year}
    </a>
  ))}
</nav>
