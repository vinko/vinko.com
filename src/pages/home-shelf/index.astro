---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection } from "astro:content";
import {
  HARBOUR_HERO,
  featuredPublishedPost,
  latestPublishedPosts,
  placePlateTags,
  tagPlainLabel,
} from "../../lib/home";
import { blogPostHref, formatDate, socialTagHref } from "../../lib/posts";
import { withBase } from "../../lib/url";

const all = await getCollection("posts");
const featured = featuredPublishedPost(all);
const latest = latestPublishedPosts(all, 10, featured?.id);
const places = placePlateTags(all, 4);
const heroSrc = withBase(HARBOUR_HERO.src);
---
<BaseLayout
  title="Story shelf"
  description="Alternate home layout — a featured post, latest writing, and places from vinko.com"
>
  <section class="hero-split" aria-label="Introduction">
    <img
      class="hero-split-photo"
      src={heroSrc}
      alt={HARBOUR_HERO.alt}
      width="640"
      height="546"
    />
    <div class="hero-split-copy">
      <h1>Vinko’s Thoughts On…</h1>
      <p class="lead">
        Notes on tech, travel, food, and photography — from a true technology versatilist.
      </p>
      <div class="btn-row">
        <a class="btn" href={withBase("/blog/")}>Read the blog</a>
        <a class="btn btn--secondary" href={withBase("/social-network/")}>Social Network</a>
      </div>
    </div>
  </section>

  <div class="page-shell">
    {featured && (
      <section class="home-lane" aria-labelledby="shelf-featured">
        <h2 class="section-heading" id="shelf-featured">Featured</h2>
        <ul class="post-grid post-grid--featured">
          <PostCard post={featured} heading="h3" href={blogPostHref(featured)} />
        </ul>
      </section>
    )}

    <section class="home-lane" aria-labelledby="shelf-latest">
      <h2 class="section-heading" id="shelf-latest">Latest</h2>
      <ul class="story-list">
        {latest.map((post) => (
          <li>
            <a href={blogPostHref(post)}>
              <time datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
              <span>{post.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {places.length > 0 && (
      <section class="home-lane" aria-labelledby="shelf-places">
        <h2 class="section-heading" id="shelf-places">Places &amp; plates</h2>
        <p class="place-links">
          {places.map((tag, index) => (
            <span>
              {index > 0 && <span aria-hidden="true"> · </span>}
              <a href={socialTagHref(tag)}>{tagPlainLabel(tag)}</a>
            </span>
          ))}
        </p>
      </section>
    )}

    <nav class="home-link-row" aria-label="About">
      <a href={withBase("/about/")}>About</a>
    </nav>
  </div>
</BaseLayout>
