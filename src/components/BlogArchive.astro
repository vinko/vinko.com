---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "./PostCard.astro";
import TagList from "./TagList.astro";
import TagFilterToggle from "./TagFilterToggle.astro";
import TagRevealToggle from "./TagRevealToggle.astro";
import YearNav from "./YearNav.astro";
import Pager from "./Pager.astro";
import type { Post } from "../lib/posts";
import { postTags } from "../lib/posts";
import { withBase } from "../lib/url";

interface Props {
  title: string;
  description: string;
  lead: string;
  posts: Post[];
  years: number[];
  currentYear?: number | "all";
  page: number;
  lastPage: number;
  pagerBase: string;
  heading?: string;
  yearBase?: string;
  postBase?: string;
  pagerLabel?: string;
  showTags?: boolean;
  currentTag?: string;
  browseTags?: string[];
}

const {
  title,
  description,
  lead,
  posts,
  years,
  currentYear = "all",
  page,
  lastPage,
  pagerBase,
  heading = "Blog",
  yearBase = withBase("/blog/"),
  postBase = withBase("/blog/"),
  pagerLabel,
  showTags = false,
  currentTag,
  browseTags = [],
} = Astro.props;
const gridId = "archive-post-grid";
const filterPanelId = "tag-browser-panel";
const canRevealTags = showTags && posts.some((post) => postTags(post).length > 0);
const canFilterTags = browseTags.length > 0;
---
<BaseLayout title={title} description={description}>
  <section class="page-shell">
    <header class="page-header">
      <h1>{heading}</h1>
      <p class="lead">{lead}</p>
    </header>
    {years.length > 0 && <YearNav years={years} current={currentYear} base={yearBase} />}
    {(canFilterTags || canRevealTags) && (
      <div class="listing-tools">
        <div class="listing-tools-row">
          {canFilterTags && (
            <div class="listing-tools-start">
              <TagFilterToggle targetId={filterPanelId} />
              {currentTag && (
                <a class="tag-filter-clear" href={postBase}>All posts</a>
              )}
            </div>
          )}
          {canRevealTags && (
            <div class="tag-reveal">
              <TagRevealToggle targetId={gridId} />
            </div>
          )}
        </div>
        {canFilterTags && (
          <nav id={filterPanelId} class="tag-browser" aria-label="Browse tags" hidden>
            <div class="tag-browser-head">
              <p class="tag-browser-label">Browse tags</p>
              <span class="tag-browser-hint">
                {currentTag ? `Filtered by ${currentTag}` : "Jump to a tag"}
              </span>
            </div>
            <TagList tags={browseTags} current={currentTag} />
          </nav>
        )}
      </div>
    )}
    <ul class="post-grid" id={gridId}>
      {posts.map((post) => (
        <PostCard post={post} href={`${postBase}${post.id}/`} showTags={showTags} />
      ))}
    </ul>
    <Pager base={pagerBase} current={page} last={lastPage} label={pagerLabel} />
  </section>
</BaseLayout>
