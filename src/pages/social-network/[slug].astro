---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import TagList from "../../components/TagList.astro";
import TagRevealToggle from "../../components/TagRevealToggle.astro";
import { getCollection, render } from "astro:content";
import {
  formatDate,
  instagramNeighbors,
  instagramPosts,
  postTags,
  relatedInstagramPosts,
  socialPostHref,
} from "../../lib/posts";
import { withBase } from "../../lib/url";
import duplicateRedirects from "../../data/instagram-duplicate-redirects.json";

export async function getStaticPaths() {
  const all = await getCollection("posts");
  const posts = instagramPosts(all);
  const live = posts.map((post) => ({
    params: { slug: post.id },
    props: { post, all, redirectTo: null as string | null },
  }));
  const liveIds = new Set(posts.map((post) => post.id));
  const dupes = Object.entries(duplicateRedirects)
    .filter(([from]) => !liveIds.has(from))
    .map(([from, to]) => ({
      params: { slug: from },
      props: {
        post: undefined,
        all,
        redirectTo: withBase(`/social-network/${to}/`),
      },
    }));
  return [...live, ...dupes];
}

const { post, all, redirectTo } = Astro.props;
if (redirectTo) {
  return Astro.redirect(encodeURI(redirectTo), 301);
}
if (!post) {
  return Astro.redirect(withBase("/social-network/"), 302);
}
const { Content } = await render(post);
const tags = postTags(post);
const { previous, next } = instagramNeighbors(all, post);
const related = relatedInstagramPosts(all, post, 3);
const listingHref = withBase("/social-network/");
const relatedGridId = "related-post-grid";
const relatedHasTags = related.some((item) => postTags(item).length > 0);
---
<BaseLayout title={post.data.title} description={post.data.description || post.data.title}>
  <article>
    <header class="page-shell page-shell--narrow post-header">
      <p class="post-kicker">
        <a href={listingHref}>Social Network</a>
      </p>
      <h1>{post.data.title}</h1>
      <time class="post-meta" datetime={post.data.pubDate.toISOString()}>
        {formatDate(post.data.pubDate)}
      </time>
      {post.data.updatedDate && (
        <p class="post-meta">Updated {formatDate(post.data.updatedDate)}</p>
      )}
    </header>
    <div class="page-shell page-shell--narrow post-body">
      <div class="prose prose--article">
        <Content />
      </div>
      {tags.length > 0 && (
        <nav class="post-tags" aria-label="Tags">
          <p class="post-tags-label">Tags</p>
          <TagList tags={tags} />
        </nav>
      )}
    </div>
  </article>

  <section class="page-shell page-shell--narrow post-footer" aria-label="More from Social Network">
    <nav class="post-step" aria-label="Previous and next Instagram posts">
      {previous ? (
        <a class="post-step-link" href={socialPostHref(previous)}>
          <span class="post-step-dir">Previous</span>
          <span class="post-step-title">{previous.data.title}</span>
        </a>
      ) : (
        <span class="post-step-link post-step-link--empty" aria-hidden="true"></span>
      )}
      {next ? (
        <a class="post-step-link post-step-link--next" href={socialPostHref(next)}>
          <span class="post-step-dir">Next</span>
          <span class="post-step-title">{next.data.title}</span>
        </a>
      ) : (
        <span class="post-step-link post-step-link--empty" aria-hidden="true"></span>
      )}
    </nav>

    {related.length > 0 && (
      <div class="related-block">
        <div class="related-head">
          <h2 class="section-heading">More like this</h2>
          {relatedHasTags && <TagRevealToggle targetId={relatedGridId} />}
        </div>
        <ul class="post-grid post-grid--related" id={relatedGridId}>
          {related.map((item) => (
            <PostCard post={item} href={socialPostHref(item)} heading="h3" showTags />
          ))}
        </ul>
      </div>
    )}

    <p class="post-back">
      <a href={listingHref}>More from Social Network</a>
    </p>
  </section>
</BaseLayout>
