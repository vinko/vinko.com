---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

function firstImage(body: string): { src: string; alt: string } | undefined {
  const md = body.match(/!\[([^\]]*)\]\(([^)\s]+)(?:\s+"[^"]*")?\)/);
  if (md) return { alt: md[1], src: md[2] };
  return undefined;
}

const heroSrc = "/wp-content/uploads/2019/02/d43b5-50177672_2052021638244499_6986579110545121136_n.jpg";
---
<BaseLayout title="Home" description="Vinko’s Thoughts On… — notes on tech, travel, food, and photography from vinko.com">
  <section class="hero" aria-label="Introduction">
    <img
      class="hero-photo"
      src={heroSrc}
      alt="Victoria Harbour, Hong Kong, photographed in 2019"
      width="640"
      height="546"
    />
    <div class="hero-veil" aria-hidden="true"></div>
    <div class="hero-copy">
      <h1>Vinko’s Thoughts On…</h1>
      <p class="lead">
        Notes on tech, travel, food, and photography — from a true technology versatilist.
      </p>
      <div class="btn-row">
        <a class="btn" href="/blog/">Read the blog</a>
      </div>
    </div>
  </section>

  <section class="page-shell">
    <h2 class="section-heading">Recent posts</h2>
    <ul class="post-grid">
      {posts.map((post) => {
        const image = firstImage(post.body);
        return (
          <li class="post-card">
            <a href={`/blog/${post.id}/`}>
              {image ? (
                <div class="card-media">
                  <img src={image.src} alt="" width="640" height="400" />
                </div>
              ) : (
                <div class="card-media card-media--empty" aria-hidden="true"></div>
              )}
              <div class="card-body">
                <div class="post-meta">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </time>
                </div>
                <h3>{post.data.title}</h3>
                {post.data.description && <p>{post.data.description}</p>}
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
</BaseLayout>
