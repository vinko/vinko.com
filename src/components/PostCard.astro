---
import { firstImage, formatDate } from "../lib/posts";
import type { Post } from "../lib/posts";
import { withBase } from "../lib/url";

interface Props {
  post: Post;
  heading?: "h2" | "h3";
}

const { post, heading = "h2" } = Astro.props;
const image = firstImage(post.body);
const Heading = heading;
---
<li class="post-card">
  <a href={withBase(`/blog/${post.id}/`)}>
    {image ? (
      <div class="card-media">
        <img src={image.src} alt="" width="640" height="400" />
      </div>
    ) : (
      <div class="card-media card-media--empty" aria-hidden="true"></div>
    )}
    <div class="card-body">
      <div class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
      </div>
      <Heading>{post.data.title}</Heading>
      {post.data.description && <p>{post.data.description}</p>}
    </div>
  </a>
</li>
