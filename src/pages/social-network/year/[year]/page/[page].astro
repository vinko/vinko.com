---
import BlogArchive from "../../../../../components/BlogArchive.astro";
import { getCollection } from "astro:content";
import { PAGE_SIZE, instagramPosts, postYears } from "../../../../../lib/posts";
import { withBase } from "../../../../../lib/url";

export async function getStaticPaths() {
  const all = instagramPosts(await getCollection("posts"));
  const years = postYears(all);
  const paths: { params: { year: string; page: string } }[] = [];
  for (const year of years) {
    const count = all.filter((p) => p.data.pubDate.getUTCFullYear() === year).length;
    const lastPage = Math.max(1, Math.ceil(count / PAGE_SIZE));
    for (let page = 2; page <= lastPage; page++) {
      paths.push({ params: { year: String(year), page: String(page) } });
    }
  }
  return paths;
}

const year = Number(Astro.params.year);
const page = Number(Astro.params.page);
const all = instagramPosts(await getCollection("posts"));
const years = postYears(all);
const yearPosts = all.filter((p) => p.data.pubDate.getUTCFullYear() === year);
const lastPage = Math.max(1, Math.ceil(yearPosts.length / PAGE_SIZE));
const posts = yearPosts.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
const archiveBase = withBase("/social-network/");
---
<BlogArchive
  title={`Social Network · ${year} · page ${page}`}
  description={`Instagram posts from ${year} — Vinko’s Thoughts On… at vinko.com`}
  heading="Social Network"
  lead={`${yearPosts.length.toLocaleString("en-US")} Instagram posts from ${year}, newest first.`}
  posts={posts}
  years={years}
  currentYear={year}
  page={page}
  lastPage={lastPage}
  pagerBase={withBase(`/social-network/year/${year}/`)}
  yearBase={archiveBase}
  postBase={archiveBase}
  pagerLabel="Social Network pages"
/>
