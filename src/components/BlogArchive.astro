---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "./PostCard.astro";
import TagList from "./TagList.astro";
import YearNav from "./YearNav.astro";
import Pager from "./Pager.astro";
import type { Post } from "../lib/posts";
import { withBase } from "../lib/url";

interface Props {
  title: string;
  description: string;
  lead: string;
  posts: Post[];
  years: number[];
  currentYear?: number | "all";
  page: number;
  lastPage: number;
  pagerBase: string;
  heading?: string;
  yearBase?: string;
  postBase?: string;
  pagerLabel?: string;
  showTags?: boolean;
  currentTag?: string;
}

const {
  title,
  description,
  lead,
  posts,
  years,
  currentYear = "all",
  page,
  lastPage,
  pagerBase,
  heading = "Blog",
  yearBase = withBase("/blog/"),
  postBase = withBase("/blog/"),
  pagerLabel,
  showTags = false,
  currentTag,
} = Astro.props;
---
<BaseLayout title={title} description={description}>
  <section class="page-shell">
    <header class="page-header">
      <h1>{heading}</h1>
      <p class="lead">{lead}</p>
    </header>
    {currentTag ? (
      <nav class="tag-filter" aria-label="Tag filter">
        <a class="tag-filter-all" href={postBase}>All posts</a>
        <TagList tags={[currentTag]} current={currentTag} />
      </nav>
    ) : (
      years.length > 0 && <YearNav years={years} current={currentYear} base={yearBase} />
    )}
    <ul class="post-grid">
      {posts.map((post) => (
        <PostCard post={post} href={`${postBase}${post.id}/`} showTags={showTags} />
      ))}
    </ul>
    <Pager base={pagerBase} current={page} last={lastPage} label={pagerLabel} />
  </section>
</BaseLayout>
