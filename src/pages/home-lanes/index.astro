---
import { withBase } from "../../lib/url";

const homeHref = withBase("/");
const canonical = new URL(homeHref, Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${homeHref}`} />
    <meta name="robots" content="noindex, follow" />
    <meta name="description" content="The Lanes desk layout is now Home." />
    <link rel="canonical" href={canonical} />
    <title>Redirecting to Home · vinko.com</title>
  </head>
  <body>
    <p>The Lanes desk layout is now Home. <a href={homeHref}>Continue to Home</a>.</p>
  </body>
</html>
